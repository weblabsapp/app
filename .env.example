APP_NAME=Home
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug

APP_URL=http://localhost
ALLOWED_ORIGINS=*.localhost
REST_API_DOMAIN=
ASSET_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Kubernetes server config
KUBE_CONNECTION=token
KUBE_HOST=http://127.0.0.1:8001
KUBE_VERIFY_SSL=false
KUBE_BEARER_TOKEN=
KUBE_MAX_EXEC_TIME=60# seconds

# Kubernetes VM
VM_SSH_USER=
VM_SSH_HOST=
VM_SSH_PRV_KEY=

# MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_API_ENDPOINT=
AWS_BUCKET=
AWS_DOWNLOAD_EXPIRE=

# Timezone
APP_TIMEZONE=

# Enable newsletter subscription
NEWSLETTER_SUBSCRIPTION_ENABLED=1

# Email Verification Expiry (Seconds)
VERIFY_EMAIL_TOKEN_EXPIRY=86400

# Access token expiry
ACCESS_TOKEN_TTL=604800

# Socialite
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WebSocket
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
LARAVEL_WEBSOCKETS_PORT=

# Debug env variables
PHP_IDE_CONFIG=serverName=docker
XDEBUG_CONFIG="client_host=gateway.docker.internal client_port=9003"