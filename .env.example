APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug

APP_URL=http://localhost
APP_PORT=8080
ALLOWED_ORIGINS=
REST_API_DOMAIN=
APP_DOMAIN=localhost
ASSET_URL=https://localhost

# Application DB config
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Docker DB config (Build config)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CACHE_DB=0

MAIL_HOST=localhost
MAIL_PORT=465
MAIL_ENCRYPTION=tls
MAIL_USERNAME=no-reply@localhost
MAIL_PASSWORD=

MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME="Laravel App"

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_DRIVER=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_CONNECTION=session
# Minutes
SESSION_LIFETIME=86400
SESSION_STORE=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

# Kubernetes server config
KUBE_CONNECTION=token
KUBE_HOST=http://localhost
KUBE_VERIFY_SSL=false
KUBE_BEARER_TOKEN=
KUBE_MAX_EXEC_TIME=30# seconds
KUBE_VOLUMES_ROOT_PATH=/path/to/volumes/directory
KUBE_DEPLOYMENT_FILE=/path/to/deployment-file.yaml
KUBE_NAMESPACE=default

# Kubernetes VM
VM_SSH_USER=
VM_SSH_HOST=localhost
VM_SSH_PRV_KEY=/path/to/id_rsa

# MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
AWS_API_ENDPOINT=
AWS_SCRIPTS_BUCKET=
AWS_ASSETS_BUCKET=
AWS_DOWNLOAD_EXPIRE=5# in minutes

# Debug env variables
PHP_IDE_CONFIG=
XDEBUG_CONFIG=

# Timezone
APP_TIMEZONE=

# Enable newsletter subscription (0 or 1)
NEWSLETTER_SUBSCRIPTION_ENABLED=0

# Email Verification Expiry (Seconds)
VERIFY_EMAIL_TOKEN_EXPIRY=

# Access token expiry (seconds)
ACCESS_TOKEN_TTL=

# Socialite
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Socket
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Nova admin
NOVA_DOMAIN_NAME=
NOVA_GUARD=
NOVA_STORAGE_DISK=

# File System Driver
FILESYSTEM_DRIVER=s3scripts