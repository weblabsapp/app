APP_NAME=Home
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug

APP_URL=http://localhost
ALLOWED_ORIGINS=*.localhost
REST_API_DOMAIN=
ASSET_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
DB_PATH_MAPPING=

REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PATH_MAPPING=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Debug env variables
PHP_IDE_CONFIG=serverName=docker
XDEBUG_CONFIG="client_host=gateway.docker.internal client_port=9003"

# Timezone
APP_TIMEZONE=
